SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_CLIENT_SAFE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_SERVICE_ROLE_KEY
DOCUMENT_HMAC_SECRET=replace-with-a-long-random-secret

# OpenCV SFace cosine similarity. Raise this to be stricter.
FACE_MATCH_THRESHOLD=0.42

# Optional on Windows if tesseract.exe is not available on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
